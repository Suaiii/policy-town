{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "investment_simulation/v0.1/agent_output",
  "title": "AgentOutput v0.1 — 专业 Agent 研判与企业 Agent 动作的统一输出契约",
  "oneOf": [
    {"$ref": "#/definitions/professional_assessment"},
    {"$ref": "#/definitions/company_plan"}
  ],
  "definitions": {
    "professional_assessment": {
      "type": "object",
      "required": ["agent", "direction", "score", "confidence", "key_factors", "evidence_ids", "reasoning_summary"],
      "properties": {
        "agent": {"type": "string", "enum": ["fiscal", "economy", "sci_tech", "development"]},
        "company_id": {"type": ["string", "null"]},
        "direction": {"type": "string", "enum": ["positive", "neutral", "negative"]},
        "score": {"type": "number", "minimum": 0, "maximum": 100},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "key_factors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["metric_id", "effect"],
            "properties": {
              "metric_id": {"type": "string"},
              "effect": {"type": "string", "enum": ["positive", "neutral", "negative"]}
            }
          }
        },
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "reasoning_summary": {"type": "string"}
      }
    },
    "company_plan": {
      "type": "object",
      "required": ["company_id", "action", "capital_request_next_round", "resource_allocation",
                   "milestone_target", "risk_response", "competition_response", "evidence_ids", "confidence"],
      "properties": {
        "company_id": {"type": "string"},
        "action": {"type": "string", "enum": ["expand", "research", "finance", "seek_orders", "contract", "relocate", "wait"]},
        "capital_request_next_round": {"type": "number", "minimum": 0},
        "resource_allocation": {
          "type": "object",
          "required": ["construction", "research", "market", "cash_buffer"],
          "properties": {
            "construction": {"type": "number"},
            "research": {"type": "number"},
            "market": {"type": "number"},
            "cash_buffer": {"type": "number"}
          }
        },
        "milestone_target": {"type": "string"},
        "risk_response": {"type": "string"},
        "competition_response": {"type": "string", "enum": ["price_cut", "market_focus", "wait", "escalate_request"]},
        "message_to_government": {"type": ["object", "null"], "description": "可选，入收件箱，下一轮生效"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
