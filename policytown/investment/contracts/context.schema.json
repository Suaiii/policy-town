{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "investment_simulation/v0.1/context",
  "title": "FrozenContext v0.1 — ContextBuilder 产出的全局只读输入",
  "type": "object",
  "required": ["stage_id", "cutoff_at", "city", "market", "companies", "inbox", "evidence_pack"],
  "properties": {
    "stage_id": {"type": "string", "enum": ["S1", "S2", "S3", "S4"]},
    "cutoff_at": {"type": "string", "description": "信息截止日 YYYY-MM-DD，之后公开的证据不得出现"},
    "city": {
      "type": "object",
      "required": ["budget_points", "committed_capital", "industrial_base", "talent_supply", "infrastructure_capacity"],
      "properties": {
        "budget_points": {"type": "number", "description": "当期可分配财政点数"},
        "committed_capital": {"type": "number"},
        "industrial_base": {"type": "object", "additionalProperties": {"type": "number"}},
        "talent_supply": {"type": "number", "minimum": 0, "maximum": 100},
        "infrastructure_capacity": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["cycle", "price_trend", "supply_pressure", "policy_support"],
        "properties": {
          "cycle": {"type": "number", "minimum": -100, "maximum": 100},
          "price_trend": {"type": "number", "minimum": -100, "maximum": 100},
          "supply_pressure": {"type": "number", "minimum": 0, "maximum": 100},
          "policy_support": {"type": "number", "minimum": 0, "maximum": 100}
        }
      }
    },
    "companies": {
      "type": "array",
      "description": "匿名化企业公开视图；禁止包含 prototype 真实案例名",
      "items": {
        "type": "object",
        "required": ["company_id", "anon_label", "industry", "metrics", "capital_request", "evidence_ids"],
        "properties": {
          "company_id": {"type": "string"},
          "anon_label": {"type": "string"},
          "industry": {"type": "string"},
          "status": {"type": "string", "enum": ["建设", "量产", "承压", "停滞", "退出"]},
          "metrics": {
            "type": "object",
            "required": ["financial_health", "execution_ability", "technology_readiness",
                         "customer_order_strength", "construction_progress", "production_ramp",
                         "project_cashflow", "capital_intensity"]
          },
          "capital_request": {"type": "number"},
          "rivals_summary": {"type": "array"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "inbox": {"type": "array", "items": {"$ref": "message.schema.json"}},
    "evidence_pack": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["evidence_id", "as_of", "publication_date", "value_type", "quality"],
        "properties": {
          "evidence_id": {"type": "string"},
          "source_id": {"type": "string"},
          "as_of": {"type": "string"},
          "publication_date": {"type": "string"},
          "value_type": {"type": "string", "enum": ["observed", "derived", "ordinal", "missing"]},
          "quality": {"type": "string", "enum": ["A", "B", "C", "D"]},
          "summary": {"type": "string"}
        }
      }
    }
  }
}
