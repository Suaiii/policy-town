{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "investment_simulation/v0.1/graph_view",
  "title": "GraphView v0.1 — 关系图是 State 的只读投影，不存储任何数据",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "label"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string", "enum": ["government", "company", "industry", "market_event"]},
          "label": {"type": "string"},
          "status": {"type": "string", "enum": ["建设", "量产", "承压", "停滞", "退出", ""]},
          "size": {"type": "number", "description": "由企业现金/进度等映射的节点大小"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "relation", "weight"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "relation": {"type": "string", "enum": ["invests", "requests", "competes", "synergy", "shocks"]},
          "weight": {"type": "number", "minimum": 0, "description": "边的粗细/强度"},
          "animated": {"type": "boolean", "description": "true 时前端做流光/脉冲动画（资金流、告急消息、事件冲击）"}
        }
      }
    }
  }
}
