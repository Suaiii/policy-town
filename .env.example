# Cognitive chat: OpenCode Go exposes an OpenAI-compatible endpoint.
LLM_PROVIDER=custom
LLM_API_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=replace-with-opencode-go-key
LLM_MODEL=deepseek-v4-flash
INVESTMENT_AGENT_LLM=1

# Python investment deliberation can receive a provider callback from the host
# application. The checked-in MVP remains deterministic when no callback is wired.
# DEPARTMENT_AGENT_PROVIDER=opencode-go

# Browser scenario narration (optional; keep this out of committed files).
VITE_LLM_API_KEY=replace-with-opencode-go-key
VITE_LLM_ENDPOINT=https://opencode.ai/zen/go/v1/chat/completions
VITE_LLM_MODEL=deepseek-v4-flash

# OpenCode Go chat models do not provide embeddings. Configure an independent
# OpenAI-compatible embedding provider for cognitive memory.
EMBEDDING_API_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=replace-with-embedding-key
EMBEDDING_MODEL=BAAI/bge-m3
